{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corral",
  "version": "0.1.1",
  "identifier": "com.luccas.corral",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Corral",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#17171a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assets/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
